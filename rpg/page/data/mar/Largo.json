{"id":"Largo","formato":"largo","dur":107.16961200000001,"serie":"CURIOSIDADES","titulo":"¿Por qué el mar es salado?","rpg":{"gancho_lugar":"playa","partidas":[{"lugar":"montana","era":"snes","nombre":"LA MONTAÑA","nota":"LLUVIA Y ROCAS"},{"lugar":"fondo","era":"nes","nombre":"EL FONDO DEL MAR","nota":"CHIMENEAS"},{"lugar":"desierto","era":"snes","nombre":"EL MAR MUERTO","nota":"AQUÍ SE FLOTA"}],"lugar":{"gancho":"playa","lluvia":"montana","trampa":"playa","fondo":"fondo","curiosidad":"playa","mar_muerto":"desierto","salinas":"playa","cierre":"puerta"},"era":{"fondo":"nes"},"fotos":["fumarola","mar_muerto","salinas"]},"segs":[{"kind":"escena","start":0.25,"dur":4.466,"voz":"2026-10-20_largo_mar_salado_gancho","vozDesde":0,"vozDur":4.466,"escena":{"texto":"¿Por qué el mar es salado, si los ríos que llegan a él son de agua dulce?","tipo":"titulo","icono":"ola","texto_grande":"¿POR QUÉ ES SALADO?","destacar":["salado,","dulce?"]},"cap":"gancho","idx":0},{"kind":"escena","start":4.716,"dur":4.251,"voz":"2026-10-20_largo_mar_salado_gancho","vozDesde":4.466,"vozDur":4.251,"escena":{"texto":"Cada litro de agua de mar lleva unos treinta y cinco gramos de sal.","tipo":"cifra","valor":"35 G","etiqueta":"DE SAL EN CADA LITRO","icono":"sal","destacar":["treinta","cinco","gramos"]},"cap":"gancho","idx":1},{"kind":"escena","start":8.967,"dur":4.16,"voz":"2026-10-20_largo_mar_salado_gancho","vozDesde":8.717,"vozDur":4.16,"escena":{"texto":"Es como echar una cucharadita y media de sal en cada vaso de agua.","tipo":"icono","icono":"vaso","destacar":["cucharadita","media"]},"cap":"gancho","idx":2},{"kind":"escena","start":13.127,"dur":5.336000000000001,"voz":"2026-10-20_largo_mar_salado_gancho","vozDesde":12.877,"vozDur":4.886000000000001,"escena":{"texto":"Vamos a seguir el viaje de un grano de sal, desde lo alto de una montaña hasta el océano.","tipo":"tarjetas","items":["MONTAÑA","RÍO","OCÉANO"],"icono":"montana","destacar":["viaje","grano"]},"cap":"gancho","idx":3},{"kind":"escena","start":18.463,"dur":2.215,"voz":"2026-10-20_largo_mar_salado_lluvia","vozDesde":0,"vozDur":2.215,"escena":{"texto":"¿De dónde sale toda esa sal?","tipo":"titulo","icono":"nube","destacar":["sal?"]},"cap":"lluvia","idx":4},{"kind":"escena","start":20.678,"dur":3.1530000000000005,"voz":"2026-10-20_largo_mar_salado_lluvia","vozDesde":2.215,"vozDur":3.1530000000000005,"escena":{"texto":"Todo empieza con la lluvia, que es un poquito ácida.","tipo":"icono","icono":"nube","destacar":["lluvia,","ácida."]},"cap":"lluvia","idx":5},{"kind":"escena","start":23.831000000000003,"dur":4.555,"voz":"2026-10-20_largo_mar_salado_lluvia","vozDesde":5.368,"vozDur":4.555,"escena":{"texto":"Gota a gota, va desgastando las rocas y les arranca minerales, como la sal.","tipo":"icono","icono":"montana","destacar":["rocas","minerales,"]},"cap":"lluvia","idx":6},{"kind":"escena","start":28.386000000000003,"dur":4.973,"voz":"2026-10-20_largo_mar_salado_lluvia","vozDesde":9.923,"vozDur":4.523,"escena":{"texto":"Y los ríos se llevan esos minerales disueltos, muy despacio, hasta el mar.","tipo":"tarjetas","items":["LLUVIA","ROCAS","RÍOS","MAR"],"icono":"gota","destacar":["ríos","mar."]},"cap":"lluvia","idx":7},{"kind":"escena","start":33.359,"dur":3.036,"voz":"2026-10-20_largo_mar_salado_trampa","vozDesde":0,"vozDur":3.036,"escena":{"texto":"Entonces, ¿por qué los ríos no saben salados?","tipo":"titulo","icono":"gota","destacar":["ríos","salados?"]},"cap":"trampa","idx":8},{"kind":"escena","start":36.395,"dur":3.8939999999999997,"voz":"2026-10-20_largo_mar_salado_trampa","vozDesde":3.036,"vozDur":3.8939999999999997,"escena":{"texto":"Porque llevan muy poquita sal, y su agua se renueva sin parar.","tipo":"comparar","izq":"RÍO","der":"MAR","destacar":["poquita","renueva"]},"cap":"trampa","idx":9},{"kind":"escena","start":40.289,"dur":4.621,"voz":"2026-10-20_largo_mar_salado_trampa","vozDesde":6.93,"vozDur":4.621,"escena":{"texto":"En el mar, el sol evapora el agua, pero la sal no se va con ella: se queda.","tipo":"icono","icono":"sol","destacar":["evapora","queda."]},"cap":"trampa","idx":10},{"kind":"escena","start":44.910000000000004,"dur":4.337000000000001,"voz":"2026-10-20_largo_mar_salado_trampa","vozDesde":11.551,"vozDur":3.8870000000000005,"escena":{"texto":"Y así, durante millones de años, la sal se ha ido acumulando.","tipo":"grafica","forma":"sube","etiquetas":["SAL"],"destacar":["millones","acumulando."]},"cap":"trampa","idx":11},{"kind":"sub","start":49.24700000000001,"dur":3.5906119999999997,"voz":"sub_es","vozDesde":0,"vozDur":2.690612,"idx":-1},{"kind":"escena","start":52.83761200000001,"dur":3.56,"voz":"2026-10-20_largo_mar_salado_fondo","vozDesde":0,"vozDur":3.56,"escena":{"texto":"Pero hay otra fuente de sal, escondida en el fondo del mar.","tipo":"titulo","icono":"pez","destacar":["escondida","fondo"]},"cap":"fondo","idx":12},{"kind":"escena","start":56.39761200000001,"dur":4.766,"voz":"2026-10-20_largo_mar_salado_fondo","vozDesde":3.56,"vozDur":4.766,"escena":{"texto":"Son chimeneas submarinas que expulsan agua muy caliente, cargada de minerales.","tipo":"foto","foto":"fumarola","etiqueta":"CHIMENEA SUBMARINA","destacar":["chimeneas","caliente,"],"credito":"Foto: NOAA Vents Program, dominio público"},"cap":"fondo","idx":13},{"kind":"escena","start":61.16361200000001,"dur":4.297,"voz":"2026-10-20_largo_mar_salado_fondo","vozDesde":8.326,"vozDur":3.8469999999999995,"escena":{"texto":"Así llegan al mar metales como el hierro, el cinc o el cobre.","tipo":"tarjetas","items":["HIERRO","CINC","COBRE"],"destacar":["hierro,","cobre."]},"cap":"fondo","idx":14},{"kind":"escena","start":65.46061200000001,"dur":2.939,"voz":"2026-10-20_largo_mar_salado_curiosidad","vozDesde":0,"vozDur":2.939,"escena":{"texto":"Curiosidad: ¿y si sacáramos toda la sal del mar?","tipo":"titulo","icono":"sal","texto_grande":"¿Y SI LA SACAMOS?","destacar":["Curiosidad:","toda"]},"cap":"curiosidad","idx":15},{"kind":"escena","start":68.39961200000002,"dur":5.42,"voz":"2026-10-20_largo_mar_salado_curiosidad","vozDesde":2.939,"vozDur":5.42,"escena":{"texto":"Repartida por todos los continentes, formaría una capa de más de ciento sesenta metros.","tipo":"cifra","valor":"+166 M","etiqueta":"DE SAL SOBRE LA TIERRA","icono":"montana","destacar":["capa","sesenta"]},"cap":"curiosidad","idx":16},{"kind":"escena","start":73.81961200000002,"dur":3.7150000000000007,"voz":"2026-10-20_largo_mar_salado_curiosidad","vozDesde":8.359,"vozDur":3.2650000000000006,"escena":{"texto":"Tan alta como un edificio de unas cuarenta plantas.","tipo":"icono","icono":"edificio","destacar":["cuarenta","plantas."]},"cap":"curiosidad","idx":17},{"kind":"escena","start":77.53461200000002,"dur":2.981,"voz":"2026-10-20_largo_mar_salado_mar_muerto","vozDesde":0,"vozDur":2.981,"escena":{"texto":"Y hay sitios todavía más salados que el océano.","tipo":"titulo","icono":"sal","destacar":["más","salados"]},"cap":"mar_muerto","idx":18},{"kind":"escena","start":80.51561200000002,"dur":3.7640000000000002,"voz":"2026-10-20_largo_mar_salado_mar_muerto","vozDesde":2.981,"vozDur":3.7640000000000002,"escena":{"texto":"En el mar Muerto, el agua es casi diez veces más salada.","tipo":"comparar","izq":"OCÉANO","der":"MAR MUERTO","destacar":["Muerto,","diez"]},"cap":"mar_muerto","idx":19},{"kind":"escena","start":84.27961200000001,"dur":4.494,"voz":"2026-10-20_largo_mar_salado_mar_muerto","vozDesde":6.745,"vozDur":4.044,"escena":{"texto":"Tanta sal hace el agua tan densa que la gente flota sin hacer nada.","tipo":"foto","foto":"mar_muerto","etiqueta":"MAR MUERTO","destacar":["densa","flota"],"credito":"Foto: Rob Bye, CC0"},"cap":"mar_muerto","idx":20},{"kind":"escena","start":88.77361200000001,"dur":2.564,"voz":"2026-10-20_largo_mar_salado_salinas","vozDesde":0,"vozDur":2.564,"escena":{"texto":"Y la sal de tu cocina puede venir del mar.","tipo":"icono","icono":"sal","destacar":["cocina","mar."]},"cap":"salinas","idx":21},{"kind":"escena","start":91.33761200000001,"dur":4.4430000000000005,"voz":"2026-10-20_largo_mar_salado_salinas","vozDesde":2.564,"vozDur":3.9930000000000003,"escena":{"texto":"En las salinas se deja que el sol evapore el agua, y queda la sal.","tipo":"foto","foto":"salinas","etiqueta":"SALINAS","destacar":["salinas","sol"],"credito":"Foto: Dey.sandip, CC BY 3.0"},"cap":"salinas","idx":22},{"kind":"escena","start":95.780612,"dur":5.994,"voz":"2026-10-20_largo_mar_salado_cierre","vozDesde":0,"vozDur":5.994,"escena":{"texto":"Así que, cuando el mar te sepa a sal, recuerda su viaje: lluvia, rocas, ríos y millones de años.","tipo":"icono","icono":"ola","destacar":["viaje:","años."]},"cap":"cierre","idx":23},{"kind":"escena","start":101.774612,"dur":5.245,"voz":"2026-10-20_largo_mar_salado_cierre","vozDesde":5.994,"vozDur":4.795,"escena":{"texto":"Suscríbete a Chispazo, y en el canal tienes muchas más curiosidades como esta.","tipo":"suscribete","destacar":["Suscríbete"]},"cap":"cierre","idx":24}],"sfx":[{"t":0.37,"type":"pen","d":1.3,"len":900},{"t":1,"type":"tap"},{"t":4.3660000000000005,"type":"whoosh"},{"t":5.016,"type":"tap"},{"t":4.836,"type":"pen","d":1,"len":600},{"t":5.6160000000000005,"type":"pen","d":0.45,"len":500},{"t":8.617,"type":"whoosh"},{"t":9.087,"type":"pen","d":1.3,"len":900},{"t":12.777000000000001,"type":"whoosh"},{"t":13.577,"type":"tap"},{"t":13.957,"type":"tap"},{"t":14.337,"type":"tap"},{"t":13.247,"type":"pen","d":1,"len":700},{"t":18.113,"type":"whoosh"},{"t":18.583000000000002,"type":"pen","d":1.3,"len":900},{"t":19.213,"type":"tap"},{"t":20.328,"type":"whoosh"},{"t":20.798000000000002,"type":"pen","d":1.3,"len":900},{"t":23.481,"type":"whoosh"},{"t":23.951000000000004,"type":"pen","d":1.3,"len":900},{"t":28.036,"type":"whoosh"},{"t":28.836000000000002,"type":"tap"},{"t":29.216,"type":"tap"},{"t":29.596000000000004,"type":"tap"},{"t":29.976000000000003,"type":"tap"},{"t":28.506000000000004,"type":"pen","d":1,"len":700},{"t":33.009,"type":"whoosh"},{"t":33.479,"type":"pen","d":1.3,"len":900},{"t":34.109,"type":