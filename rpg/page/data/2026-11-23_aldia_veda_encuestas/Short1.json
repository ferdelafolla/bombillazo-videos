{"id": "Short1", "formato": "short", "dur": 39.7871, "serie": "AL DÍA", "titulo": "¿Por qué no hay encuestas la última semana? 🗳️", "rpg": {"gancho_lugar": "redaccion", "fin": ["MÁS DATOS", "CADA DÍA EN EL CANAL"], "partidas": [{"lugar": "redaccion", "era": "snes", "nombre": "LA REDACCIÓN", "nota": "SIN ENCUESTAS"}, {"lugar": "colegio", "era": "snes", "nombre": "EL COLEGIO", "nota": "5 DÍAS"}, {"lugar": "andorra", "era": "snes", "nombre": "ANDORRA", "nota": "FRUTAS"}], "lugar": {"gancho": "redaccion", "veda": "colegio", "curiosidad": "andorra"}, "era": {}, "fotos": []}, "segs": [{"kind": "escena", "start": 0.6, "dur": 3.455, "voz": "2026-11-23_aldia_veda_encuestas_gancho", "vozDesde": 0, "vozDur": 3.455, "escena": {"texto": "Desde mañana, en España no se pueden publicar encuestas.", "tipo": "titulo", "destacar": ["encuestas."], "accion": "sellar", "texto_grande": "¡SIN ENCUESTAS!"}, "cap": "gancho", "idx": 0}, {"kind": "escena", "start": 4.055, "dur": 5.268, "voz": "2026-11-23_aldia_veda_encuestas_gancho", "vozDesde": 3.455, "vozDur": 4.068, "escena": {"texto": "Las elecciones generales son este domingo, veintinueve de noviembre.", "tipo": "icono", "destacar": ["veintinueve"], "accion": "calendario", "rotulo": "29-N"}, "cap": "gancho", "idx": 1}, {"kind": "escena", "start": 9.323, "dur": 3.048, "voz": "2026-11-23_aldia_veda_encuestas_veda", "vozDesde": 0, "vozDur": 3.048, "escena": {"texto": "¿Y por qué se prohíben justo al final de la campaña?", "tipo": "icono", "destacar": ["final"], "accion": "pregunta"}, "cap": "veda", "idx": 2}, {"kind": "escena", "start": 12.371, "dur": 4.248, "voz": "2026-11-23_aldia_veda_encuestas_veda", "vozDesde": 3.048, "vozDur": 4.248, "escena": {"texto": "La ley electoral prohíbe publicarlas los cinco días antes de votar.", "tipo": "icono", "destacar": ["cinco"], "accion": "cinco_dias", "rotulo": "5 DÍAS"}, "cap": "veda", "idx": 3}, {"kind": "escena", "start": 16.619, "dur": 3.829999999999999, "voz": "2026-11-23_aldia_veda_encuestas_veda", "vozDesde": 7.296, "vozDur": 3.829999999999999, "escena": {"texto": "La idea es que un sondeo de última hora no condicione el voto.", "tipo": "icono", "destacar": ["condicione"], "accion": "condicionar"}, "cap": "veda", "idx": 4}, {"kind": "escena", "start": 20.449, "dur": 6.061000000000001, "voz": "2026-11-23_aldia_veda_encuestas_veda", "vozDesde": 11.126, "vozDur": 4.861000000000001, "escena": {"texto": "Pero las encuestas se siguen haciendo: lo prohibido es publicarlas en España.", "tipo": "icono", "destacar": ["publicarlas"], "accion": "encuestar"}, "cap": "veda", "idx": 5}, {"kind": "escena", "start": 26.51, "dur": 5.826, "voz": "2026-11-23_aldia_veda_encuestas_curiosidad", "vozDesde": 0, "vozDur": 5.826, "escena": {"texto": "Curiosidad: por eso salen en medios de Andorra, a veces con los partidos disfrazados de frutas.", "tipo": "icono", "destacar": ["frutas."], "accion": "frutas"}, "cap": "curiosidad", "idx": 6}, {"kind": "escena", "start": 32.336, "dur": 5.666, "voz": "2026-11-23_aldia_veda_encuestas_curiosidad", "vozDesde": 5.826, "vozDur": 4.466, "escena": {"texto": "Suscríbete a Chispazo, y en el canal tienes muchas más curiosidades como esta.", "tipo": "suscribete", "destacar": ["Suscríbete"]}, "cap": "curiosidad", "idx": 7}, {"kind": "final", "start": 38.002, "dur": 1.6351019999999998, "voz": "final_es", "vozDesde": 0, "vozDur": 0.235102, "idx": -1, "remate": "¿POR QUÉ SE PROHÍBEN?"}], "sfx": [{"t": 0.72, "type": "pen", "d": 1.3, "len": 900}, {"t": 1.35, "type": "tap"}, {"t": 3.7049999999999996, "type": "whoosh"}, {"t": 4.175, "type": "pen", "d": 1.3, "len": 900}, {"t": 8.973, "type": "whoosh"}, {"t": 9.443, "type": "pen", "d": 1.3, "len": 900}, {"t": 12.021, "type": "whoosh"}, {"t": 12.491, "type": "pen", "d": 1.3, "len": 900}, {"t": 16.269, "type": "whoosh"}, {"t": 16.739, "type": "pen", "d": 1.3, "len": 900}, {"t": 20.398999999999997, "type": "swell"}, {"t": 22.4646324, "type": "tap"}, {"t": 22.5146324, "type": "ding"}, {"t": 23.350019999999997, 