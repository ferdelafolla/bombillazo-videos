,"vozDesde":2.213,"vozDur":3.622,"escena":{"texto":"Es cuando el precio de algo sube muy por encima de lo que vale.","tipo":"grafica","forma":"sube","etiquetas":["PRECIO","VALOR"],"destacar":["precio","vale."]},"cap":"que_es","idx":6},{"kind":"escena","start":24.324,"dur":4.075,"voz":"2026-10-15_largo_burbuja_ia_que_es","vozDesde":5.835,"vozDur":4.075,"escena":{"texto":"La gente compra porque sube, y sube porque la gente compra.","tipo":"icono","icono":"ciclo","destacar":["compra","sube,"]},"cap":"que_es","idx":7},{"kind":"escena","start":28.399,"dur":4.5680000000000005,"voz":"2026-10-15_largo_burbuja_ia_que_es","vozDesde":9.91,"vozDur":4.118,"escena":{"texto":"Hasta que un día faltan compradores, y el precio cae de golpe.","tipo":"grafica","forma":"cae","etiquetas":["¡PLOF!"],"destacar":["cae"]},"cap":"que_es","idx":8},{"kind":"escena","start":32.967,"dur":1.69,"voz":"2026-10-15_largo_burbuja_ia_curiosidad","vozDesde":0,"vozDur":1.69,"escena":{"texto":"¿Por qué se llama burbuja?","tipo":"titulo","icono":"burbuja","destacar":["burbuja?"]},"cap":"curiosidad","idx":9},{"kind":"escena","start":34.657,"dur":7.143000000000001,"voz":"2026-10-15_largo_burbuja_ia_curiosidad","vozDesde":1.69,"vozDur":7.143000000000001,"escena":{"texto":"Curiosidad: el nombre viene de 1720, de la Compañía de los Mares del Sur, en Inglaterra.","tipo":"cifra","valor":"1720","etiqueta":"MARES DEL SUR","icono":"barco","destacar":["Curiosidad:","1720,"]},"cap":"curiosidad","idx":10},{"kind":"escena","start":41.8,"dur":5.611000000000001,"voz":"2026-10-15_largo_burbuja_ia_curiosidad","vozDesde":8.833,"vozDur":5.611000000000001,"escena":{"texto":"Sus acciones se multiplicaron por diez en pocos meses… y luego se hundieron.","tipo":"grafica","forma":"pico","etiquetas":["×10"],"destacar":["diez","hundieron."]},"cap":"curiosidad","idx":11},{"kind":"escena","start":47.411,"dur":4.421999999999999,"voz":"2026-10-15_largo_burbuja_ia_curiosidad","vozDesde":14.444,"vozDur":4.421999999999999,"escena":{"texto":"